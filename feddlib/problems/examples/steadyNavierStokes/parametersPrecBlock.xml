<ParameterList name="Block Preconditioner">
    
    
    <!-- ++++++++ -->
    <!-- Velocity -->
    <!-- ++++++++ -->
    <ParameterList name="Velocity preconditioner">
        <Parameter name="Number of blocks" type="int" value="1"/>
        <ParameterList name="ThyraPreconditioner">
            <Parameter name="Preconditioner Type" type="string" value="FROSch"/>
            <ParameterList name="Preconditioner Types">
                <ParameterList name="FROSch">
                    <Parameter name="FROSch Preconditioner Type" type="string" value="OneLevelPreconditioner"/>
                    
                    <Parameter name="Recycling" type="bool" value="true"/>
                    <Parameter name="DofsPerNode1" type="int" value="2"/>
                    <Parameter name="DofOrdering1" type="string" value="NodeWise"/>
                    
                    <Parameter name="Overlap" type="int" value="1"/>
                    
                    <Parameter name="Level Combination" type="string" value="Additive"/><!--Multiplicative,Additive-->
                    <Parameter name="OverlappingOperator Type" type="string" value="AlgebraicOverlappingOperator"/>
                    
                    <Parameter name="CoarseOperator Type" type="string" value="RGDSWCoarseOperator"/><!--GDSWCoarseOperator,IPOUHarmonicCoarseOperator-->
                    
                    <ParameterList name="AlgebraicOverlappingOperator">
                        <Parameter name="Reuse: Symbolic Factorization" type="bool" value="true"/>
                        <Parameter name="Combine Values in Overlap" type="string" value="Averaging"/><!--Restricted,Averaging,Full-->
                        <Parameter name="Adding Layers Strategy" type="string" value="CrsGraph"/>
                        <Parameter name="Level ID" type="int" value="1"/>
                        
                        <ParameterList name="Solver">
                            <Parameter name="SolverType" type="string" value="Amesos2"/>
                            
                            <Parameter name="Solver" type="string"   value="klu2"/>

                           <!-- <Parameter name="SolverType" type="string" value="Ifpack2"/>          
                            <Parameter name="Solver"        type="string"   value="RILUK"/>  
                                <ParameterList name="Ifpack2">
                                <!-- Level of fill: 0 = ILU(0), 1 = ILU(1), etc. default: 0 -->
                                <Parameter name="fact: iluk level-of-fill" type="int" value="1"/>
                                    <!-- Diagonal perturbation for stability, default: 0 -->
                                <Parameter name="fact: absolute threshold" type="double" value="1e-5"/>
                                    <!-- Diagonal scaling factor (1.0 = no scaling), default: 1.0 -->
                                <Parameter name="fact: relative threshold" type="double" value="1.01"/>
                            </ParameterList>  -->
                                <!--<ParameterList name="Ifpack2">                                 
									<Parameter name="fact: iluk level-of-overlap" type="int" value="0"/>
									<Parameter name="fact: drop tolerance" type="double" value="1e-5"/>
									<Parameter name="fact: relative threshold" type="double" value="1.0"/> 
									<Parameter name="fact: relax value" type="double" value="0.0"/> 
									<Parameter name="fact: initial relax value" type="double" value="0.0"/>
									<Parameter name="fact: diagonal threshold" type="double" value="0.0"/> 
									<Parameter name="fact: reuse symbolic" type="bool" value="true"/> 
									<Parameter name="fact: reuse numeric" type="bool" value="false"/> 
                                  </ParameterList> -->      

                            
                        </ParameterList>
                        
                    </ParameterList>
                    
                                        
                    <ParameterList name="RGDSWCoarseOperator">
                         <Parameter name="Reuse: Coarse Basis" type="bool" value="true"/>
		                <Parameter name="Reuse: Coarse Matrix" type="bool" value="true"/>
		                
		                <Parameter name="Reuse: Extension Symbolic Factorization" type="bool" value="true"/>
		                <Parameter name="Reuse: Coarse Matrix Symbolic Factorization" type="bool" value="true"/>
                        <Parameter name="Use Triple MatrixMultiply"                     type="bool"     value="true"/>
                        <Parameter name="Test Unconnected Interface"                    type="bool"     value="true"/>
                        
	                    <Parameter name="Phi: Dropping Threshold" type="double" value="1.0e-3"/>	
	                    
                        <ParameterList name="Blocks">
                            <ParameterList name="1">
                                <Parameter name="Exclude"	                            type="string"   value="0"/>
                                <Parameter name="Use For Coarse Space"                  type="bool"     value="true"/>
                                <Parameter name="Option"                                type="string"   value="1"/>
                                <Parameter name="Rotations"                             type="bool"     value="false"/>
                            </ParameterList>
                        </ParameterList>
                        
                        <ParameterList name="ExtensionSolver">
                            <Parameter name="SolverType"                                type="string"   value="Amesos2"/>
                            <Parameter name="Solver"                                    type="string"   value="klu2"/>
                            <ParameterList name="Amesos2">
                            </ParameterList>
                        </ParameterList>
                        
                        <ParameterList name="Distribution">
                            <Parameter name="Type"                                      type="string"   value="linear"/>
                            <Parameter name="GatheringSteps"                            type="int"      value="2"/>
                            <Parameter name="NumProcs"                                  type="int"      value="4"/>
                            <Parameter name="Factor"                                    type="double"   value="1.0"/>
                            <!-- NumProcs = Factor * NumProcs -->
                        </ParameterList>
                        
                        <ParameterList name="CoarseSolver">
                            <Parameter name="SolverType"                                type="string"   value="Amesos2"/>
                            <Parameter name="Solver"                                    type="string"   value="klu2"/>
                            <ParameterList name="Amesos2">
                                
                            </ParameterList>
                        </ParameterList>
                        
                    </ParameterList>
                    
                </ParameterList>
            </ParameterList>
            
        </ParameterList>
    </ParameterList>
    
    
    <!-- ++++++++++++++++ -->
    <!-- Schur complement -->
    <!-- ++++++++++++++++ -->
    <ParameterList name="Schur complement preconditioner">
        <Parameter name="Number of blocks" type="int" value="1"/>
        <ParameterList name="ThyraPreconditioner">
            <Parameter name="Preconditioner Type" type="string" value="FROSch"/>
            <ParameterList name="Preconditioner Types">
                <ParameterList name="FROSch">
                    <Parameter name="FROSch Preconditioner Type" type="string" value="OneLevelPreconditioner"/>
						<Parameter name="Recycling" type="bool" value="true"/>
						<Parameter name="Dimension" type="int"      value="2"/>
						<Parameter name="DofsPerNode" type="int" value="2"/>
						<Parameter name="DofOrdering" type="string" value="NodeWise"/>
						<Parameter name="Overlap" type="int" value="1"/>
						<Parameter name="TwoLevel" type="bool" value="false"/>
						<Parameter name="Level Combination"  type="string" value="Additive"/>
						<Parameter name="OverlappingOperator Type" type="string" value="AlgebraicOverlappingOperator"/>
						<Parameter name="CoarseOperator Type" type="string"   value="RGDSWCoarseOperator"/>
						<ParameterList name="AlgebraicOverlappingOperator">
							<Parameter name="Reuse Symbolic Factorization"                  type="bool"     value="true"/>
							<Parameter name="Combine Values in Overlap" type="string" value="Averaging"/><!--Restricted,Averaging,Full-->
							<Parameter name="Level ID"                                      type="int"      value="1"/>
							<ParameterList name="Solver">
								<Parameter name="SolverType"                                type="string"   value="Amesos2"/>
								<Parameter name="Solver"                                    type="string"   value="klu2"/>
							</ParameterList>
						</ParameterList>
						<ParameterList name="RGDSWCoarseOperator">
							<Parameter name="Use Triple MatrixMultiply"                     type="bool"     value="false"/>
							<Parameter name="Test Unconnected Interface"                    type="bool"     value="false"/>
						    <Parameter name="Reuse: Coarse Basis" type="bool" value="true"/>
                            <Parameter name="Reuse: Coarse Matrix" type="bool" value="true"/>
                            <Parameter name="Phi: Dropping Threshold" type="double" value="1.0e-3"/>	
                            <Parameter name="Reuse: Extension Symbolic Factorization" type="bool" value="true"/>
                            <Parameter name="Reuse: Coarse Matrix Symbolic Factorization" type="bool" value="true"/>
                                <ParameterList name="Blocks">
                                    <ParameterList name="1">
                                        <Parameter name="Exclude"	                            type="string"   value="2"/>
                                        <Parameter name="Use For Coarse Space"                  type="bool"     value="true"/>
                                        <Parameter name="Option"                                type="string"   value="1"/>
                                        <Parameter name="Rotations"                             type="bool"     value="false"/>
                                    </ParameterList>
                                </ParameterList>

                                <ParameterList name="ExtensionSolver">
                                    <Parameter name="SolverType"                                type="string"   value="Amesos2"/>
                                    <Parameter name="Solver"                                    type="string"   value="klu2"/>
                                </ParameterList>

                                <ParameterList name="Distribution">
                                    <Parameter name="Type"                                      type="string"   value="linear"/>
                                    <Parameter name="GatheringSteps"                            type="int"      value="1"/>
                                    <Parameter name="NumProcs"                                  type="int"      value="1"/>
                                    <Parameter name="Factor"                                    type="double"   value="1.0"/>
                                    <!-- NumProcs = Factor * NumProcs -->
                                </ParameterList>

                                <ParameterList name="CoarseSolver">
                                    <Parameter name="SolverType"                                type="string"   value="Amesos2"/>
                                    <Parameter name="Solver"                                    type="string"   value="klu2"/>
                                </ParameterList>
                    </ParameterList>
                </ParameterList>
            </ParameterList> 
        </ParameterList>
    </ParameterList>    
</ParameterList>
