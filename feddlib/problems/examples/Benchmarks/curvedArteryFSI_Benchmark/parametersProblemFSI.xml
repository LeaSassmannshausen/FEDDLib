<!--
    Curved artery FSI benchmark: checkpoint/restart usage.

    All optional checkpoint, recovery and output-history modes below are disabled
    by default, preserving the original benchmark configuration.

    1. Produce checkpoints: set Timestepping Parameter/Checkpointing=true and
       choose the Checkpoints times and Checkpoint directory. The example schedule
       saves at 0.4 and 0.8 s. FSI writes a state when the following timestep starts,
       so Final time must be at least one dt beyond the last checkpoint required.
    2. Resume: set Restart=true, Restart directory to the producer directory and
       Time step to the saved physical time (for example 0.4). Keep Final time
       greater than that time. To read without writing new ordinary checkpoints,
       set Checkpointing=false and General/Safe all solution=false.
    3. To write checkpoints during continuation, choose a DIFFERENT Checkpoint
       directory, for example resumedCheckpoints. This also applies to saving every
       solution. Copy the complete source directory, including manifests, fluid
       history, Newmark displacement/velocity/acceleration, ALE fields and outlet
       state. Keep mesh, FE orders, dt, BDF, beta/gamma and outlet-model settings
       compatible with the source. Metadata validation runs before restoration.
    4. Continue visualization/text output with Exporter/Resume output=true, or
       archive it with Resume output=false and Keep old output=true. Keep output
       filenames, suffixes, mesh-writing mode and export interval when resuming.
    5. For failure recovery, enable Failure recovery and use a fresh Recovery
       directory. The existing NOX solver and the built-in Newton/FixedPoint paths
       provide solve reports. To restart from
       recovery, read the directory and physical time from Latest.xml, or select
       its protected generation, and use the ordinary Restart settings above.
       Restore normal solver limits and use a fresh directory for new recovery data.

    Initial solution loading at time zero currently supports standalone multistep
    Navier-Stokes only, not FSI/Newmark. Restart tolerance, Restart absolute tolerance
    and Compare restart are test-driver controls, not options used by this benchmark.
    Compatibility metadata and outlet-state version keys are generated by the code;
    they are not user settings. See doc/restart.md for the full checkpoint contract.
-->
<ParameterList name="FSI">
    <ParameterList name="Parameter">
        <Parameter name="Dimension" type="int" value="3"/>
        <Parameter name="Discretization" type="string" value="P2"/><!--P2-->
            
        <Parameter name="Model Geometry" type="string" value="Laplace"/>

        <Parameter name="FSI" type="bool" value="true"/>
        <Parameter name="Geometry Explicit" type="bool" value="true"/>

        <Parameter name="relNonLinTol" type="double" value="1.0e-6"/>
        <Parameter name="absNonLinTol" type="double" value="1.0e-6"/>
        <Parameter name="updateTol" type="double" value="1.0e-6"/>
        <Parameter name="Combo" type="string" value="OR"/>
        <Parameter name="Use update tol" type="bool" value="true"/>
        <Parameter name="Use WRMS" type="bool" value="false"/>

        <!-- BUILDING PRECONDITIONER ONLY THE FIRST X (newtonLimit) NEWTON STEP(S) -->
        <Parameter name="newtonLimit" type="int" value="3"/>
        <Parameter name="Rebuild Preconditioner every Newton Iteration" type="bool" value="true"/>
        <!--  -->
     

        <Parameter name="MaxNonLinIts" type="int" value="20"/>
        <!-- True stops on nonlinear nonconvergence; enabled recovery preserves the preceding reliable state
             and diagnostics first. False continues, while recovery retains the last
             reliable state rather than replacing it with an unreliable trajectory.
             A converged solve with high linear iteration counts does not stop. -->
        <Parameter name="Cancel MaxNonLinIts" type="bool" value="false"/>

        <Parameter name="Criterion" type="string" value="Update"/><!-- Criterion for nonlinear solve, Residual or Update: Residual is the norm of the nonlinear residual; Update is the norm of the update -->
    </ParameterList>
    <ParameterList name="Parameter Solid">        
        <Parameter name="Material model" type="string" value="Neo-Hooke"/><!--Saint Venant-Kirchhoff,Neo-Hooke, Mooney-Rivlin -->
        <Parameter name="Density" type="double"   value="1.0e-03"/><!-- kg/cm³ -->
        <!-- Parameters NH4 Neo Hooke Model from 'Comparison of arterial wall models in fluid–structure interaction simulations' -->
        <Parameter name="Mu" type="double" value="1476.5"/><!-- 1kg⋅cm/s² * 1/cm²-->
        <Parameter name="Mu1" type="double" value="1476.5"/><!-- 1kg⋅cm/s² * 1/cm²-->
        <Parameter name="Mu2" type="double" value="1476.5"/><!-- 1kg⋅cm/s² * 1/cm²-->

        <Parameter name="E" type="double" value="4400.0"/> <!-- 1kg⋅cm/s² * 1/cm² -->
        <Parameter name="E1" type="double" value="4400.0"/><!-- 1kg⋅cm/s² * 1/cm²-->
        <Parameter name="E2" type="double" value="4400.0"/><!-- 1kg⋅cm/s² * 1/cm²-->

        <Parameter name="c1" type="double" value="0.25"/>
        <Parameter name="Poisson Ratio" type="double" value="0.49"/>
    </ParameterList>

    <ParameterList name="Parameter Fluid">
        <Parameter name="Ramp type" type="string" value="cos"/><!--cos, linear -->
        <Parameter name="Max Velocity" type="double" value="118.28"/><!--2d:2.0, Richter 3d: 1.0-->
        <Parameter name="Max Ramp Time" type="double" value="0.1"/>

        <Parameter name="Flowrate" type="double" value="3."/><!-- For Absorbing BC-->

        <Parameter name="Viscosity" type="double" value="2.31e-2"/> <!-- kinematic viscosity cm^2/s converted from dynamic visco 0.003 Pa s -->
        <Parameter name="Density" type="double" value="1.3e-03"/><!-- kg/cm³ -->
        <Parameter name="Symmetric gradient" type="bool" value="true"/>

        <Parameter name="Pressure Boundary Condition" type="string" value="Absorbing Paper"/>         <!-- Resistance , Absorbing , Absorbing Resistance-->
        <Parameter name="Unsteady Start" type="double" value="0.2"/><!-- Start of 'unsteady' phase -->
        <Parameter name="Average Flowrate" type="bool" value="true"/>
        <Parameter name="BC Ramp" type="double" value="0.0"/>
        <Parameter name="Normal Scale" type="double" value="-1.0"/>
        <Parameter name="Poisson Ratio" type="double" value="0.49"/>
        <!-- Absorbing boundary condition -->
        <Parameter name="Reference fluid pressure" type="double" value="10.66e1"/> <!-- 1kg⋅cm/s² * 1/cm²  -->
        <Parameter name="Wall thickness" type="double" value="0.06"/> <!-- cm -->
        <Parameter name="E" type="double" value="120.0e1"/> <!-- 1kg⋅cm/s² * 1/cm²-->
        <!-- Resistance boundary condition -->
        <Parameter name="Resistance" type="double" value="3.6660e-4"/> <!-- ?? CHECK| old: g/cm s² s/cm³ (eigentliche Einheit mPa*s/m³ , 1mPa = 10e6 N/m² -->
        <Parameter name="Resistance Ramp" type="double" value="0.0"/>
    </ParameterList>
    
    <ParameterList name="Parameter Geometry">
        <Parameter name="Poisson Ratio" type="double" value="0.49e-0"/>
        <Parameter name="Mu" type="double" value="126.700e1"/>
        <Parameter name="Model Geometry" type="string" value="Laplace"/>
        <Parameter name="Model" type="string" value="Laplace"/>
        <Parameter name="Distance Laplace" type="double" value="0.1"/>
        <Parameter name="Coefficient Laplace" type="double" value="1000."/>
    </ParameterList>
    
    <ParameterList name="Mesh Partitioner">
        <Parameter name="Contiguous" type="bool" value="true"/>
        <Parameter name="Mesh Number" type="string" value="2"/> <!-- Mesh Number for #2, #3, #4 Mesh-->
        <Parameter name="Mesh 1 Name" type="string" value="fluidBenchmark2.mesh"/> <!-- fluidBenchmark2.mesh, fluidBenchmark3.mesh, fluidBenchmark4.mesh Geometry is in cm! -->
        <Parameter name="Mesh 2 Name" type="string" value="structureBenchmark2.mesh"/> <!-- structureBenchmark2.mesh, structureBenchmark3.mesh, structureBenchmark4.mesh -->      
        <Parameter name="Automatic partition" type="bool" value="false"/> <!-- find ratio for ranks based on the number of elements of each mesh -->
        
        <Parameter name="Mesh 1 fraction ranks" type="int" value="-1"/> <!-- percentage of ranks for mesh 1; if Automatic partition=true this will be ignored; if set below 0 number of ranks will be used -->
        <Parameter name="Mesh 1 number ranks" type="int" value="-1"/><!-- number of ranks for this mesh; if Automatic partition=true this will be ignored; if fraction ranks>=0 this will be ignored -->
        
        <Parameter name="Mesh 2 fraction ranks" type="int" value="-1"/>
        <Parameter name="Mesh 2 number ranks" type="int" value="-1"/>    
    </ParameterList>

    <ParameterList name="Exporter">
        <!-- Used only with Timestepping Parameter/Restart=true. Continue existing
             ParaView HDF5/XMF series and supported text logs through Time step;
             discard later entries and append the resumed trajectory without a
             duplicate restart frame. Missing output starts a new series. Keep
             HDF5/XMF pairs, optional _times.xmf files and text .times sidecars
             together. Incompatible output layouts/cadence are rejected. -->
        <Parameter name="Resume output" type="bool" value="false"/>
        <!-- When Resume output=false, move existing files opened by the active
             exporters to old_output/run_1, run_2, etc. before writing fresh output.
             Applies to fresh runs as well as restarts; checkpoint files are excluded.
             Resume output=true takes precedence. Both false keep overwrite behavior. -->
        <Parameter name="Keep old output" type="bool" value="false"/>

        <!-- Keep this mesh-writing mode and the export interval unchanged when
             resuming an existing visualization series. -->
        <Parameter name="Write new mesh" type="bool" value="false"/>
        <Parameter name="Export every X timesteps" type="int" value="1"/>
        
        <Parameter name="Export GE geometry solution" type="bool" value="true"/>
        
        <Parameter name="Export coarse functions" type="bool" value="false"/>
        
        <Parameter name="Name coarse functions block1" type="string" value="phiU"/>
        <Parameter name="Name coarse functions block2" type="string" value="phiP"/>
        <Parameter name="Name coarse functions block3" type="string" value="phiD"/>
        <Parameter name="Exclude coarse functions block4" type="bool" value="true"/>
        
    </ParameterList>
    <ParameterList name="General">
        <Parameter name="Mpi Ranks Coarse" type="int" value="0"/>
        <Parameter name="ParaViewExport" type="bool" value="true"/>
        <Parameter name="ParaViewCoarse" type="bool" value="false"/>
        <Parameter name="ParaView export subdomains" type="bool" value="true"/>
        
        <Parameter name="Export Suffix" type="string" value=""/>
        <Parameter name="Export Data" type="bool" value="true"/>
        <Parameter name="Export Flow Rate" type="bool" value="true"/>

        <!-- Legacy spelling: save the solution and required restart history at every
             step, even with Checkpointing=false. This can produce substantial I/O.
             Uses Timestepping Parameter/Checkpoint directory, which must differ
             from Restart directory when restarting. FSI retains its start-of-step
             convention, so its final solved state needs a following step to be saved. -->
        <Parameter name="Safe all solution" type="bool" value="false"/>

        <Parameter name="Flag Inlet Fluid" type="int" value="2"/>
        <Parameter name="Flag Outlet Fluid" type="int" value="3"/>

        <Parameter name="Preconditioner Method" type="string" value="FaCSI"/><!-- Monolithic, FaCSI, FaCSI-Teko -->
        <Parameter name="Use Fluid Preconditioner" type="bool" value="true"/>
        <Parameter name="Use Solid Preconditioner" type="bool" value="true"/>

        <Parameter name="Only Diagonal" type="bool" value="false"/>

        <Parameter name="Scale mass matrix" type="bool" value="true"/>
        <Parameter name="Set Zeros" type="bool" value="true"/>
        
        <!-- Ordinary checkpoint/restart and failure recovery support this NOX
             configuration. Built-in Newton and FixedPoint also supply recovery reports. -->
        <Parameter name="Linearization" type="string" value="NOX"/> <!-- FixedPoint, Newton, Extrapolation-->
    </ParameterList>
    <ParameterList name="Timestepping Parameter">
        
        <Parameter name="BDF" type="int" value="2"/>
        <Parameter name="Class" type="string" value="Multistep"/>
        <!-- Checkpoint/restart requires fixed dt; adaptive and segmented timestep
             schedules are not supported by the current compatibility contract. -->
        <Parameter name="Timestepping type" type="string" value="non-adaptive"/>
    
        <Parameter name="Final time" type="double" value="1.2"/>
        <Parameter name="dt" type="double" value="0.005"/>
        <Parameter name="beta" type="double" value="0.25"/> <!-- newmark method parameter-->
        <Parameter name="gamma" type="double" value="0.5"/> <!-- newmark method parameter-->

        <!-- ORDINARY CHECKPOINT PRODUCTION: independent of failure recovery.
             Configure these settings on this coupled FSI list; FSI propagates them
             to its fluid and Newmark solid components automatically. -->
        <Parameter name="Checkpointing" type="bool" value="false"/>
        <!-- Output directory for fields, integration history, geometry, component
             manifests and enabled outlet state. Creating output HDF5 files truncates
             them; use a different output directory when reading a restart. -->
        <Parameter name="Checkpoint directory" type="string" value="restartCheckpoints"/>
        <!-- Must match the number of entries below, numbered consecutively from 1.
             The schedule is inactive while Checkpointing=false. -->
        <Parameter name="Number Checkpoints" type="int" value="2"/>
        <!-- Physical times in seconds on the fixed dt grid, with sufficient BDF2
             history available. Keep FSI checkpoints at least two steps apart because
             each checkpoint also exports its previous-step history. -->
        <ParameterList name="Checkpoints">
            <Parameter name="1" type="double" value="0.4"/>
            <Parameter name="2" type="double" value="0.8"/>
        </ParameterList>

        <!-- RESTORATION: enable to load the complete coupled state and resume its
             physical clock. No separate Newmark/geometry/outlet restart flags exist. -->
        <Parameter name="Restart" type="bool" value="false"/>
        <!-- Input directory; it may be a complete recovery generation. If also writing
             ordinary checkpoints or saving every solution, change Checkpoint directory
             to e.g. resumedCheckpoints. Identical paths and aliases are rejected. -->
        <Parameter name="Restart directory" type="string" value="restartCheckpoints"/>
        <!-- Physical checkpoint time in seconds, NOT the timestep duration dt.
             Ignored when Restart=false; select a checkpoint that actually exists. -->
        <Parameter name="Time step" type="double" value="0.4"/>
        <!-- Explicitly permit old checkpoints without compatibility manifests.
             Dataset/history checks still run, but mesh/integration compatibility
             cannot be verified. Enabled outlet models still require their versioned
             outlet-state file. This does not repair incomplete or corrupt HDF5 data. -->
        <Parameter name="Allow legacy restart" type="bool" value="false"/>

        <!-- FAILURE RECOVERY: independent of the ordinary Checkpoints schedule.
             Uses the solve report from NOX or the built-in Newton/FixedPoint solver.
             Preserve the state preceding an unconverged/nonfinite solve or failed
             linear solve, and protect it when linear iteration counts become high.
             Recovery does not automatically retry a timestep or change dt. -->
        <Parameter name="Failure recovery" type="bool" value="false"/>
        <!-- Use a fresh directory per run. Complete.xml marks each published generation;
             Latest.xml identifies the latest and protected generations. RecoveryStatus.xml
             records trigger/iteration/convergence information. Ordinary checkpoints
             are separate, and existing recovery generations are never truncated. -->
        <Parameter name="Recovery directory" type="string" value="recoveryCheckpoints"/>
        <!-- Range [0,1]. Trigger when the average linear iterations over the nonlinear
             updates STRICTLY exceeds this fraction of the active Belos Maximum
             Iterations (configured in parametersSolverFSI.xml). Geometry solves are
             excluded; direct solvers have no iteration-count trigger. -->
        <Parameter name="Recovery linear iteration fraction" type="double" value="0.5"/>
        <!-- Nonnegative interval for periodic recovery publication: 1 writes each captured
             step; larger values reduce routine I/O; 0 retains captures in memory until
             a trigger or active warning requires publication. Hard process/node failures
             can recover only generations already on disk. Under the FSI convention the
             latest capture can precede the final solution by one timestep. -->
        <Parameter name="Recovery interval steps" type="int" value="1"/>
    </ParameterList>
</ParameterList>
