            <Parameter name="MThetaMinus" type="double" value="3.0" />
            <Parameter name="ThetaPlus1" type="double" value="1.000882" />
            <Parameter name="ThetaPlus2" type="double" value="1.234826" />
            <Parameter name="ThetaPlus3" type="double" value="1.141419" />
            <Parameter name="ThetaMinus1" type="double" value="0.98" />
            <Parameter name="ThetaMinus2" type="double" value="0.98" />
            <Parameter name="ThetaMinus3" type="double" value="0.98" />
        </ParameterList>
    </ParameterList>
    <ParameterList name="Parameter Diffusion">
        <!-- No chemical loading: zero initial concentration, diffusion and
             reaction. main.cpp also supplies a zero diffusion tensor. -->
        <Parameter name="D0" type="double" value="0.0" />
        <Parameter name="m" type="double" value="0.0" />
    </ParameterList>
    <!-- Both L2 and Linf comparisons use absTol + relTol * norm(FSI).
         Concentration is checked independently against zero. Iteration counts
         must agree exactly; only log-rounding of averages has a small allowance. -->
    <ParameterList name="Validation">
        <Parameter name="Absolute tolerance" type="double" value="1.e-10" />
        <Parameter name="Relative tolerance" type="double" value="1.e-7" />
        <Parameter name="Concentration tolerance" type="double" value="1.e-14" />
    </ParameterList>
</ParameterList>
