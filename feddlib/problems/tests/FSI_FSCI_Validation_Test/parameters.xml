            <Parameter name="Alpha2" type="double" value="499.8e1" />
            <Parameter name="Alpha3" type="double" value="2.4" />
            <Parameter name="Alpha4" type="double" value="30001.9e1" />
            <Parameter name="Alpha5" type="double" value="5.1" />
            <Parameter name="K2" type="double" value="0.2e0" />
            <Parameter name="K5" type="double" value="0.2e0" />
            <Parameter name="K3" type="double" value="0.134" />
            <Parameter name="K4" type="double" value="0.00166" />
            <Parameter name="K7" type="double" value="0.66e-4" />
            <Parameter name="Ca50" type="double" value="0.4" />
            <Parameter name="Gamma2" type="double" value="50.0" />
            <Parameter name="Gamma3" type="double" value="0.9" />
            <Parameter name="LambdaC50" type="double" value="1.2" />
            <Parameter name="Gamma4" type="double" value="200." />
            <Parameter name="Zeta1" type="double" value="100." />
            <Parameter name="Gamma5" type="double" value="50." />
            <Parameter name="Zeta2" type="double" value="100.0" />
            <Parameter name="DeltaLambdaBarPMin" type="double" value="-1.e-5" />
            <Parameter name="Gamma6" type="double" value="1.5" />
            <Parameter name="LambdaP50" type="double" value="1.0" />
            <Parameter name="Eta" type="double" value="0.1624" />
            <Parameter name="Gamma1" type="double" value="0.5131" />
            <Parameter name="LambdaBarCDotMax" type="double" value="0.0443" />
            <Parameter name="LambdaBarCDotMin" type="double" value="-0.0443" />
            <Parameter name="KDotMin" type="double" value="-0.0010694" />
            <Parameter name="KDotMax" type="double" value="0.0009735" />
            <Parameter name="LambdaBarDotPMin" type="double" value="-0.0002323" />
            <Parameter name="LambdaBarDotPMax" type="double" value="0.0000699" />
            <Parameter name="Kappa" type="double" value="103.78e1" />
            <Parameter name="Beta1" type="double" value="0.001006" />
            <Parameter name="Beta2" type="double" value="26.68e1" />
            <Parameter name="MuA" type="double" value="11.857e1" />
            <Parameter name="KMin" type="double" value="0.015" />
            <Parameter name="D0" type="double" value="0.0" />
            <Parameter name="M" type="double" value="0.0" />
            <Parameter name="P" type="double" value="2.9580835205796716" />
            <Parameter name="P1" type="double" value="0.6" />
            <Parameter name="P3" type="double" value="0.6" />
            <Parameter name="Gamma1Max" type="double" value="0.5131" />
            <Parameter name="Gamma1Min" type="double" value="0.07797910389823641" />
            <Parameter name="Gamma3Min" type="double" value="0.13677878297366072" />
            <Parameter name="Gamma3Max" type="double" value="0.9" />
            <Parameter name="C50" type="double" value="0.6673453235597163" />
            <Parameter name="growthStartTime" type="double" value="10000.0" />
            <Parameter name="reorientationStartTime" type="double" value="10000.0" />
            <Parameter name="growthEndTime" type="double" value="10000.0" />
            <Parameter name="reorientationEndTime" type="double" value="10000.0" />
            <Parameter name="Density" type="double" value="1.e-3" />
            <Parameter name="ActiveBool" type="double" value="0" />
            <Parameter name="growthBool" type="double" value="0" />
            <Parameter name="reorientationBool" type="double" value="0" />
            <Parameter name="growthDirectionBool" type="double" value="0" />
            <Parameter name="PostProcessingType" type="double" value="1." />
            <Parameter name="PostProcessingPower" type="double" value="1." />
            <Parameter name="ActiveStartTime" type="double" value="1000.0" />
            <Parameter name="kEtaPlus" type="double" value="0.6" />
            <Parameter name="mEtaPlus" type="double" value="5.0" />
            <Parameter name="KThetaPlus" type="double" value="1.0" />
            <Parameter name="KThetaMinus" type="double" value="1.0" />
