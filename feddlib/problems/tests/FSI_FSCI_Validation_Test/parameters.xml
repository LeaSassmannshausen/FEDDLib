<!-- Shared physical input for both FSI and FSCI.
     main.cpp copies this list and sets the formulation/preconditioner flags. -->
<ParameterList name="FSI/FSCI validation">
    <ParameterList name="Parameter">
        <Parameter name="Dimension" type="int" value="3" />
        <Parameter name="Discretization" type="string" value="P2" />
        <Parameter name="Model Geometry" type="string" value="Laplace" />
        <Parameter name="FSI" type="bool" value="true" />
        <Parameter name="Geometry Explicit" type="bool" value="true" />
        <Parameter name="relNonLinTol" type="double" value="1.e-8" />
        <Parameter name="MaxNonLinIts" type="int" value="15" />
        <Parameter name="Cancel MaxNonLinIts" type="bool" value="true" />
        <Parameter name="Criterion" type="string" value="Residual" />
        <Parameter name="SCI" type="bool" value="false" />
        <Parameter name="Chemistry Explicit" type="bool" value="false" />
        <Parameter name="Load Stepping" type="bool" value="false" />
        <Parameter name="Structure Model" type="string" value="SCI_SMC_Active_Growth_Reorientation" />
    </ParameterList>
    <ParameterList name="Parameter Fluid">
        <Parameter name="Preconditioner Type" type="string" value="Monolithic" />
        <Parameter name="Viscosity" type="double" value="2.91e-2" />
        <Parameter name="Density" type="double" value="1.03e-03" />
        <Parameter name="Symmetric gradient" type="bool" value="true" />
        <Parameter name="Max Ramp Time" type="double" value="0.00625" />
        <Parameter name="Flowrate" type="double" value="0.001" />
        <Parameter name="Unsteady Start" type="double" value="0.00625" />
        <Parameter name="Average Flowrate" type="bool" value="true" />
        <Parameter name="Use Inflow" type="bool" value="false" />
        <Parameter name="BC Ramp" type="double" value="0.0" />
        <Parameter name="Normal Scale" type="double" value="-1.0" />
        <Parameter name="Poisson Ratio" type="double" value="0.49" />
        <Parameter name="Reference fluid pressure" type="double" value="11.99e1" />
        <Parameter name="Wall thickness" type="double" value="0.12" />
        <Parameter name="E" type="double" value="120.0e1" />
        <Parameter name="Resistance" type="double" value="3.9966e1" />
        <Parameter name="Pressure Boundary Condition" type="string" value="Resistance" />
        <Parameter name="Resistance Type" type="string" value="Constant" />
        <Parameter name="Distal Pressure" type="double" value="0.0" />
    </ParameterList>
    <ParameterList name="Parameter Geometry">
        <Parameter name="Poisson Ratio" type="double" value="0.49e-0" />
        <Parameter name="Mu" type="double" value="126.700e1" />
        <Parameter name="Model Geometry" type="string" value="Laplace" />
        <Parameter name="Model" type="string" value="Laplace" />
        <Parameter name="Distance Laplace" type="double" value="0.1" />
        <Parameter name="Coefficient Laplace" type="double" value="1000." />
    </ParameterList>
    <ParameterList name="Mesh Partitioner">
        <Parameter name="Contiguous" type="bool" value="true" />
        <Parameter name="Mesh 1 Name" type="string" value="fsi_fluid_length_0_5_mm.mesh" />
        <Parameter name="Mesh 2 Name" type="string" value="fsi_solid_length_0_5_mm.mesh" />
        <Parameter name="Automatic partition" type="bool" value="false" />
        <Parameter name="Mesh 1 fraction ranks" type="int" value="-1" />
        <Parameter name="Mesh 1 number ranks" type="int" value="-1" />
        <Parameter name="Mesh 2 fraction ranks" type="int" value="-1" />
        <Parameter name="Mesh 2 number ranks" type="int" value="-1" />
    </ParameterList>
    <ParameterList name="General">
        <Parameter name="ParaViewExport" type="bool" value="false" />
        <Parameter name="Export Data" type="bool" value="true" />
        <Parameter name="Export Flow Rate" type="bool" value="false" />
        <Parameter name="Preconditioner Method" type="string" value="FaCSI" />
        <Parameter name="Use Fluid Preconditioner" type="bool" value="true" />
        <Parameter name="Use Solid Preconditioner" type="bool" value="true" />
        <Parameter name="Linearization" type="string" value="Newton" />
        <Parameter name="Flag Inlet Fluid" type="int" value="4" />
        <Parameter name="Flag Outlet Fluid" type="int" value="5" />
        <Parameter name="Flag Interface" type="int" value="6" />
    </ParameterList>
    <ParameterList name="Timestepping Parameter">
        <!-- Exactly two accepted steps from zero. The first uses BDF1 startup;
             the second exercises BDF2 fluid history and Newmark solid history. -->
        <Parameter name="BDF" type="int" value="2" />
        <Parameter name="Class" type="string" value="Multistep" />
        <Parameter name="Timestepping type" type="string" value="non-adaptive" />
        <Parameter name="dt" type="double" value="0.0025" />
        <Parameter name="beta" type="double" value="0.25" />
        <Parameter name="gamma" type="double" value="0.5" />
        <Parameter name="Final time" type="double" value="0.005" />
        <Parameter name="Checkpointing" type="bool" value="false" />
        <Parameter name="Restart" type="bool" value="false" />
    </ParameterList>
    <ParameterList name="Parameter Solid">
        <!-- Both formulations evaluate this same native material at c=0.
             All response phases stay disabled during the comparison. -->
        <Parameter name="Material model" type="string" value="SCI_SMC_Active_Growth_Reorientation" />
        <Parameter name="Density" type="double" value="1.0e-03" />
        <Parameter name="Mu" type="double" value="1476.5" />
        <Parameter name="E" type="double" value="4400.0" />
        <Parameter name="Poisson Ratio" type="double" value="0.49" />
        <Parameter name="Use AceGen Interface" type="bool" value="true" />
        <Parameter name="SCI" type="bool" value="true" />
        <Parameter name="Structure Model" type="string" value="SCI_SMC_Active_Growth_Reorientation" />
        <Parameter name="Number of Materials" type="int" value="1" />
        <ParameterList name="1">
            <Parameter name="Volume Flag" type="int" value="15" />
            <Parameter name="Compute FA" type="bool" value="false" />
            <Parameter name="Fibre angle" type="double" value="30." />
