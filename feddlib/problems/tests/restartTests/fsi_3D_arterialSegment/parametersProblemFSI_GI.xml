<!-- GI overrides for the arterial restart regression. The base artery inputs
     supply mesh, material and outlet settings, including Parameter Fluid/Use Inflow.
     The producer advances one extra
     step to write the 0.01 s checkpoint under FSI's start-of-step convention.
     Boundary samples compare deformed areas, current/previous flow and pressure
     before the first resumed Newton solve, including a paper-model transition. -->
<ParameterList name="FSI GI restart regression">
    <ParameterList name="Parameter">
        <Parameter name="Geometry Explicit" type="bool" value="false"/>
        <!-- Tight solves keep the continuation comparison sensitive to restart errors. -->
        <Parameter name="relNonLinTol" type="double" value="1.e-10"/>
    </ParameterList>
    <ParameterList name="Timestepping Parameter">
        <Parameter name="Restart" type="bool" value="false"/>
        <Parameter name="Time step" type="double" value="0.005"/>
        <Parameter name="Final time" type="double" value="0.0125"/>
        <Parameter name="Checkpointing" type="bool" value="true"/>
        <Parameter name="Checkpoint directory" type="string" value="restartCheckpoints"/>
        <Parameter name="Restart directory" type="string" value="restartCheckpoints"/>
        <Parameter name="Restart tolerance" type="double" value="1.e-8"/>
        <Parameter name="Restart absolute tolerance" type="double" value="1.e-12"/>
        <Parameter name="Number Checkpoints" type="int" value="2"/>
        <ParameterList name="Checkpoints">
            <Parameter name="1" type="double" value="0.005"/>
            <Parameter name="2" type="double" value="0.01"/>
        </ParameterList>
    </ParameterList>
</ParameterList>
