SET(work "@CMAKE_CURRENT_BINARY_DIR@/@performance_test_name@")
FILE(REMOVE_RECURSE "${work}")
FILE(MAKE_DIRECTORY "${work}")
EXECUTE_PROCESS(COMMAND "@MPI_EXEC@"
    @MPI_EXEC_PRE_NUMPROCS_FLAGS@ @MPI_EXEC_NUMPROCS_FLAG@ 9
    @MPI_EXEC_POST_NUMPROCS_FLAGS@ "${EXECUTABLE}"
    "--benchmarkfile=@CMAKE_CURRENT_BINARY_DIR@/parametersBenchmark.xml"
    --aspect=all --dimension=@dimension@ --H-h=3 --steps=4 --restart-steps=2 --repetitions=1
    "--problemfile=@CMAKE_CURRENT_BINARY_DIR@/parametersProblem.xml"
    "--precfile=@CMAKE_CURRENT_BINARY_DIR@/parametersPrec.xml"
    "--solverfile=@CMAKE_CURRENT_BINARY_DIR@/parametersSolver.xml"
    --output-directory=results
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE result)
IF(NOT result STREQUAL "0")
    MESSAGE(FATAL_ERROR "Structured BFS performance run failed: ${result}")
ENDIF()

# Require measured operations, not a particular runtime or solution-error bound.
FILE(READ "${work}/results/timings.csv" timings)
FOREACH(operation checkpoint_write compatibility_validate primary_fields_read bdf_history_read initial_solution_load paraview_resume
        check_for_export export files_close teardown nonlinear_solve nonlinear_residual
        jacobian_assembly combine_systems bdf_history_update bdf_rhs)
    IF(NOT timings MATCHES ",${operation},")
        MESSAGE(FATAL_ERROR "Missing performance measurement: ${operation}")
    ENDIF()
ENDFOREACH()

# TimeMonitor scopes must also appear beneath the benchmark regions in the stack.
FILE(READ "${work}/results/stacked_timings.txt" stacked_timings)
FOREACH(region "BFS restart performance" repeat_1 checkpoint_run restart resume_output initial_solution
        mesh_build problem_initialization advance teardown
        "FEDD - NonLinearSolver - Solve" "FEDD - NonLinearSolver - Jacobian Assembly"
        "FEDD - TimeProblem - Nonlinear Residual" "FEDD - TimeProblem - Combine Systems"
        "FEDD - TimeProblem - BDF History Update" "FEDD - TimeProblem - BDF RHS"
        "FEDDlib: Checkpoint Feature - files_close"
        "FEDDlib: Checkpoint Feature - checkpoint_write" "FEDDlib: Checkpoint Feature - compatibility_validate"
        "FEDDlib: Checkpoint Feature - bdf_history_read" "FEDDlib: Checkpoint Feature - initial_solution_load"
        "FEDDlib: Checkpoint Feature - paraview_resume" "FEDDlib: Checkpoint Feature - check_for_export" "FEDDlib: Checkpoint Feature - export")
    STRING(FIND "${stacked_timings}" "${region}" region_position)
    IF(region_position EQUAL -1)
        MESSAGE(FATAL_ERROR "Missing stacked timing region: ${region}")
    ENDIF()
ENDFOREACH()
