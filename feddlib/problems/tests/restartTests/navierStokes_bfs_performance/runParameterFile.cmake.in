# Launch using only the benchmark XML. Put the inputs in a different directory
# to exercise resolution of its relative physics/preconditioner/solver paths.
SET(work "@CMAKE_CURRENT_BINARY_DIR@/@parameter_test_name@")
FILE(REMOVE_RECURSE "${work}")
FILE(MAKE_DIRECTORY "${work}/inputs")
FOREACH(input IN ITEMS @performance_inputs@)
    FILE(COPY "@CMAKE_CURRENT_BINARY_DIR@/${input}" DESTINATION "${work}/inputs")
ENDFOREACH()
EXECUTE_PROCESS(COMMAND "@MPI_EXEC@"
    @MPI_EXEC_PRE_NUMPROCS_FLAGS@ @MPI_EXEC_NUMPROCS_FLAG@ 9
    @MPI_EXEC_POST_NUMPROCS_FLAGS@ "${EXECUTABLE}"
    --benchmarkfile=inputs/parametersBenchmark.xml
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE result)
IF(NOT result STREQUAL "0")
    MESSAGE(FATAL_ERROR "Parameter-file benchmark run failed: ${result}")
ENDIF()
# Verify the resolved XML controls and the timer branches produced by each repetition.
FILE(READ "${work}/performance_restart/parametersEffective.xml" parameters)
FOREACH(setting "Dimension=2" "H/h=5" "Aspect=restart" "Repetitions=2" "MPI ranks=9" "Subdomains per unit=1")
    STRING(REPLACE "=" ";" fields "${setting}")
    LIST(GET fields 0 name)
    LIST(GET fields 1 value)
    IF(NOT parameters MATCHES "<Parameter [^>]*name=\"${name}\"[^>]*value=\"${value}\"")
        MESSAGE(FATAL_ERROR "Unexpected benchmark control from XML: ${setting}")
    ENDIF()
ENDFOREACH()
FILE(READ "${work}/performance_restart/stacked_timings.txt" stacked_timings)
FOREACH(repeat 1 2)
    STRING(FIND "${stacked_timings}" "|   repeat_${repeat}:" repeat_position)
    IF(repeat_position EQUAL -1)
        MESSAGE(FATAL_ERROR "Missing stacked timing branch for repetition ${repeat}")
    ENDIF()
    FOREACH(phase checkpoint_run restart)
        IF(NOT EXISTS "${work}/performance_restart/repeat_${repeat}/${phase}/${phase}.xml")
            MESSAGE(FATAL_ERROR "Missing ${phase} run for repetition ${repeat}")
        ENDIF()
    ENDFOREACH()
ENDFOREACH()
STRING(REGEX MATCHALL "FEDDlib: Checkpoint Feature - bdf_history_read:" history_timers "${stacked_timings}")
LIST(LENGTH history_timers history_count)
IF(NOT history_count EQUAL 2)
    MESSAGE(FATAL_ERROR "Expected one restart history timer in each repetition")
ENDIF()
IF(EXISTS "${work}/performance_restart/timings.csv")
    MESSAGE(FATAL_ERROR "The benchmark should only write stacked timing output")
ENDIF()
