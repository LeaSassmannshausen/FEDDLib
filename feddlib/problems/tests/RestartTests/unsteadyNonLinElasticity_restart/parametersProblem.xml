<ParameterList name="unsteady nonlinear elasticity restart">
    <ParameterList name="Parameter">
        <Parameter name="Dimension" type="int" value="2"/>
        <Parameter name="Discretization" type="string" value="P1"/>
        <Parameter name="Source Type" type="string" value="surface"/>
        <Parameter name="Volume force" type="double" value="-0.32"/>
        <Parameter name="Material model" type="string" value="Saint Venant-Kirchhoff"/>
        <Parameter name="Density" type="double" value="1."/>
        <Parameter name="Poisson Ratio" type="double" value="0.48"/>
        <Parameter name="Mu" type="double" value="0.1275"/>
        <Parameter name="relNonLinTol" type="double" value="1.e-12"/>
        <Parameter name="MaxNonLinIts" type="int" value="10"/>
        <Parameter name="Cancel MaxNonLinIts" type="bool" value="true"/>
        <Parameter name="Criterion" type="string" value="Residual"/>
    </ParameterList>
    <ParameterList name="Mesh Partitioner">
        <Parameter name="Contiguous" type="bool" value="true"/>
        <Parameter name="Mesh 1 Name" type="string" value="square_h02.mesh"/>
    </ParameterList>
    <ParameterList name="General">
        <Parameter name="Linearization" type="string" value="Newton"/>
        <Parameter name="Preconditioner Method" type="string" value="Monolithic"/>
        <Parameter name="ParaViewExport" type="bool" value="false"/>
        <Parameter name="Export Data" type="bool" value="false"/>
    </ParameterList>
    <ParameterList name="Timestepping Parameter">
        <Parameter name="Class" type="string" value="Newmark"/>
        <Parameter name="Timestepping type" type="string" value="non-adaptive"/>
        <Parameter name="dt" type="double" value="0.0025"/>
        <Parameter name="beta" type="double" value="0.25"/>
        <Parameter name="gamma" type="double" value="0.5"/>
        <Parameter name="Restart" type="bool" value="false"/>
        <Parameter name="Checkpointing" type="bool" value="true"/>
        <Parameter name="Checkpoint directory" type="string" value="restartCheckpoints"/>
        <Parameter name="Number Checkpoints" type="int" value="2"/>
        <ParameterList name="Checkpoints">
            <Parameter name="1" type="double" value="0.005"/>
            <Parameter name="2" type="double" value="0.01"/>
        </ParameterList>
        <!-- Newmark currently writes the 0.01 state when the next step starts. -->
        <Parameter name="Final time" type="double" value="0.0125"/>
        <Parameter name="Comparison time" type="double" value="0.01"/>
        <Parameter name="Restart tolerance" type="double" value="1.e-12"/>
    </ParameterList>
</ParameterList>
