# Stream the usual solver output; isolate files from other restart tests.
SET(work "@CMAKE_CURRENT_BINARY_DIR@/@outlet_test_name@")
FILE(REMOVE_RECURSE "${work}")
FILE(MAKE_DIRECTORY "${work}")
FOREACH(input IN ITEMS @fsi_3D_arterialSegment_parameter_files@ fsi_fluid_length_0_5_mm.mesh fsi_solid_length_0_5_mm.mesh)
    FILE(COPY "@CMAKE_CURRENT_BINARY_DIR@/${input}" DESTINATION "${work}")
ENDFOREACH()
# Normal tests only read a private copy of frozen reference checkpoints.
# Rejection checks below may modify this copy; the committed bundle stays intact.
SET(reference "@CMAKE_CURRENT_BINARY_DIR@/ReferenceSolutions/@outlet_name@")
IF(NOT EXISTS "${reference}/Solutionu_f.h5")
    MESSAGE(FATAL_ERROR "Missing arterial reference bundle: ${reference}. Generate it explicitly; CTest never regenerates references.")
ENDIF()
FILE(MAKE_DIRECTORY "${work}/restartCheckpoints")
FILE(COPY "${reference}/" DESTINATION "${work}/restartCheckpoints")
SET(command "@MPI_EXEC@" @MPI_EXEC_PRE_NUMPROCS_FLAGS@
    @MPI_EXEC_NUMPROCS_FLAG@ 4 @MPI_EXEC_POST_NUMPROCS_FLAGS@
    "${EXECUTABLE}" "--pressure-model=@outlet_model@" --restart-steps=2)
FUNCTION(run_phase label)
    MESSAGE(STATUS "Arterial @outlet_model@: ${label}")
    EXECUTE_PROCESS(COMMAND ${command} ${ARGN} WORKING_DIRECTORY "${work}" RESULT_VARIABLE result)
    IF(NOT result STREQUAL "0")
        MESSAGE(FATAL_ERROR "${label} failed: ${result}")
    ENDIF()
ENDFUNCTION()
IF("@outlet_model@" STREQUAL "Resistance")
    # One two-step restart also checks save-all output with Checkpointing=false.
    run_phase("Save-all restart: 0.005 to 0.01 s, two timesteps"
        --problemfile=parametersProblemFSI_restart.xml
        --restart-time=0.005 --save-all --checkpoint-output=saveAllCheckpoints)
    FOREACH(saved_time 0.005000 0.007500)
        IF(NOT EXISTS "${work}/saveAllCheckpoints/FSIOutletState_${saved_time}.xml")
            MESSAGE(FATAL_ERROR "Missing save-all outlet state at ${saved_time}")
        ENDIF()
    ENDFOREACH()
ELSE()
    run_phase("Restart at 0.005 s" --problemfile=parametersProblemFSI_restart.xml --restart-time=0.005)
    run_phase("Restart at 0.01 s" --problemfile=parametersProblemFSI_restart.xml --restart-time=0.01)
ENDIF()

# Assert rejection through the actual FSI constructor, before solution loading.
FUNCTION(expect_rejection label diagnostic)
    EXECUTE_PROCESS(COMMAND ${command} --problemfile=parametersProblemFSI_restart.xml
        --validate-checkpoint ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    IF(result STREQUAL "0" OR NOT "${output}${errors}" MATCHES "${diagnostic}")
        MESSAGE(FATAL_ERROR "${label}: expected rejection, got ${result}\n${output}${errors}")
    ENDIF()
    MESSAGE(STATUS "PASS expected outlet checkpoint rejection: ${label}")
ENDFUNCTION()
FILE(SHA256 "${work}/restartCheckpoints/Solutiond_f.h5" geometry_before)
expect_rejection("checkpoint output overwrites restart input" "must be different"
    --checkpoint-output=restartCheckpoints/../restartCheckpoints)
FILE(SHA256 "${work}/restartCheckpoints/Solutiond_f.h5" geometry_after)
IF(NOT geometry_before STREQUAL geometry_after)
    MESSAGE(FATAL_ERROR "Rejected restart modified the geometry checkpoint")
ENDIF()
expect_rejection("changed averaging" "Average Flowrate" --incompatible-outlet)
SET(state "${work}/restartCheckpoints/FSIOutletState_0.005000.xml")
FILE(READ "${state}" original)
FILE(REMOVE "${state}")
expect_rejection("missing outlet state" "Missing FSI outlet checkpoint")
FILE(WRITE "${state}" "${original}")
STRING(REPLACE "name=\"Format version\" type=\"int\" value=\"1\""
    "name=\"Format version\" type=\"int\" value=\"999\"" changed "${original}")
FILE(WRITE "${state}" "${changed}")
expect_rejection("unknown outlet state version" "Incompatible FSI outlet checkpoint")
FILE(WRITE "${state}" "${original}")
