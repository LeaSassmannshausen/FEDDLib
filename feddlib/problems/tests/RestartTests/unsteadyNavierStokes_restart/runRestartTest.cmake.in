# Keep setup quiet and let each MPI run stream its normal stdout/stderr.
IF(NOT DEFINED TEST_WORKING_DIRECTORY)
    SET(TEST_WORKING_DIRECTORY "@CMAKE_CURRENT_BINARY_DIR@/@restart_test_name@")
ENDIF()
FILE(REMOVE_RECURSE "${TEST_WORKING_DIRECTORY}")
FILE(MAKE_DIRECTORY "${TEST_WORKING_DIRECTORY}")
SET(input_files
    parametersProblem.xml
    parametersProblem@dimension@D.xml
    parametersProblem_restart.xml
    parametersProblem_reference.xml
    parametersProblem_restart_final.xml
    parametersPrec.xml
    parametersSolver.xml
    @restart_test_mesh@
)
FOREACH(input_file IN LISTS input_files)
    FILE(COPY "@CMAKE_CURRENT_BINARY_DIR@/${input_file}"
        DESTINATION "${TEST_WORKING_DIRECTORY}")
ENDFOREACH()

SET(mpi_command "@MPI_EXEC@"
    @MPI_EXEC_PRE_NUMPROCS_FLAGS@
)
SET(test_command
    "${EXECUTABLE}"
    --problemfile=parametersProblem@dimension@D.xml
)
FUNCTION(run_phase phase mpi_procs)
    EXECUTE_PROCESS(COMMAND ${mpi_command}
        @MPI_EXEC_NUMPROCS_FLAG@ ${mpi_procs}
        @MPI_EXEC_POST_NUMPROCS_FLAGS@
        ${test_command} ${ARGN}
        WORKING_DIRECTORY "${TEST_WORKING_DIRECTORY}"
        RESULT_VARIABLE result
    )
    IF(NOT result STREQUAL "0")
        MESSAGE(FATAL_ERROR "${phase} failed: ${result}")
    ENDIF()
ENDFUNCTION()

run_phase("Reference stopping at 0.02" @reference_mpi_procs@)
run_phase("Restart from 0.01 to 0.02" @restart_mpi_procs@
    --restartfile=parametersProblem_restart.xml)
run_phase("Independent reference stopping at 0.03" @reference_mpi_procs@
    --overridefile=parametersProblem_reference.xml)
run_phase("Restart from final checkpoint at 0.02 to 0.03" @restart_mpi_procs@
    --restartfile=parametersProblem_restart_final.xml)
