<ParameterList name="FSI">
    <!-- Shared 2D Turek case for the reference and restart phases. -->
    <ParameterList name="Parameter">
        <Parameter name="MeanVelocity" type="double" value="2.0"/>
        <Parameter name="FSI" type="bool" value="true"/>
        <Parameter name="Geometry Explicit" type="bool" value="true"/>
        <Parameter name="relNonLinTol" type="double" value="1.0e-6"/>
        <Parameter name="MaxNonLinIts" type="int" value="10"/>
        <Parameter name="Criterion" type="string" value="Residual"/>
    </ParameterList>
    <ParameterList name="Parameter Solid">
        <Parameter name="Material model" type="string" value="linear"/>
        <Parameter name="Density" type="double" value="1000."/>
        <Parameter name="Poisson Ratio" type="double" value="0.4"/>
        <Parameter name="Mu" type="double" value="2.0e+6"/>
    </ParameterList>
    <ParameterList name="Parameter Fluid">
        <Parameter name="Viscosity" type="double" value="1.0e-3"/>
        <Parameter name="Density" type="double" value="1000.0"/>
        <Parameter name="Symmetric gradient" type="bool" value="true"/>
    </ParameterList>
    <ParameterList name="Mesh Partitioner">
        <Parameter name="Contiguous" type="bool" value="true"/>
        <Parameter name="Mesh 1 Name" type="string" value="dfg_fsi_fluid_h004.mesh"/>
        <Parameter name="Mesh 2 Name" type="string" value="dfg_fsi_solid_h004.mesh"/>
        <Parameter name="Automatic partition" type="bool" value="false"/>
        <Parameter name="Mesh 1 fraction ranks" type="int" value="-1"/>
        <Parameter name="Mesh 1 number ranks" type="int" value="-1"/>
        <Parameter name="Mesh 2 fraction ranks" type="int" value="-1"/>
        <Parameter name="Mesh 2 number ranks" type="int" value="-1"/>
    </ParameterList>
    <ParameterList name="General">
        <Parameter name="Mpi Ranks Coarse" type="int" value="0"/>
        <Parameter name="ParaViewExport" type="bool" value="false"/>
        <Parameter name="Export Data" type="bool" value="false"/>
        <Parameter name="Export Extra Data" type="bool" value="false"/>
        <Parameter name="Export drag and lift" type="bool" value="false"/>
        <Parameter name="Preconditioner Method" type="string" value="FaCSI"/>
        <Parameter name="Use Fluid Preconditioner" type="bool" value="true"/>
        <Parameter name="Use Solid Preconditioner" type="bool" value="true"/>
        <Parameter name="Linearization" type="string" value="Newton"/>
        <Parameter name="Export Flow Rate" type="bool" value="false"/>
    </ParameterList>
    <ParameterList name="Timestepping Parameter">
        <Parameter name="Checkpointing" type="bool" value="true"/>
        <Parameter name="Checkpoint directory" type="string" value="restartCheckpoints"/>
        <Parameter name="Number Checkpoints" type="int" value="2"/>
        <ParameterList name="Checkpoints">
            <Parameter name="1" type="double" value="0.01"/>
            <Parameter name="2" type="double" value="0.02"/>
        </ParameterList>
        <Parameter name="Restart" type="bool" value="false"/>
        <Parameter name="Restart tolerance" type="double" value="1.e-12"/>
        <Parameter name="BDF" type="int" value="2"/>
        <Parameter name="Class" type="string" value="Multistep"/>
        <Parameter name="Timestepping type" type="string" value="non-adaptive"/>
        <!-- Advance one extra step so the checkpoint at 0.02 is written. -->
        <Parameter name="Final time" type="double" value="0.022"/>
        <Parameter name="dt" type="double" value="0.002"/>
        <Parameter name="beta" type="double" value="0.25"/>
        <Parameter name="gamma" type="double" value="0.5"/>
    </ParameterList>
</ParameterList>
